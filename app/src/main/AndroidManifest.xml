<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.flashblocker"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- min/targetSdk are also in app/build.gradle (used by Gradle). Declared
         here so the gradle-free manual build produces the correct SDK level. -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- The app does NOT read, send or store SMS; the AccessibilityService
         below is protected by the system's BIND_ACCESSIBILITY_SERVICE
         (android:permission on the <service>). The only permission requested
         is POST_NOTIFICATIONS, used solely to remind the user to re-enable
         the service when a timed pause (⋮ menu, for bank apps) runs out —
         Android has no API for the app to re-enable itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Main screen: status and statistics. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The service that detects and closes the Class 0 popup. -->
        <service
            android:name=".FlashSmsAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Fires when a timed pause runs out; reminds the user via notification
             to re-enable the accessibility service (Android has no API to do
             it automatically). -->
        <receiver
            android:name=".PauseExpiredReceiver"
            android:exported="false" />

    </application>
</manifest>
